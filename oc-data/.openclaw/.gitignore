# Everything in this state dir is per-machine / auto-generated by default.
# Track only the bot config and the user-authored workspace.
*

!.gitignore
!openclaw.json

# Workspace holds the bot's persona (USER.md, SOUL.md, AGENTS.md, ...) and
# any custom skills.
!workspace/
!workspace/**

# Re-ignore the workspace's own runtime: nested git, sessions, sqlite memory,
# dream journal, ephemeral state.
workspace/.git/
workspace/.openclaw/
workspace/state/
workspace/memory/
workspace/DREAMS.md
