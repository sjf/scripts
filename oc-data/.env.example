# Copy to .env on the VPS, fill in real values, chmod 600.
# Compose loads this automatically via the env_file directive
# in openclaw/docker-compose.yml.
#
# Discord IDs: enable Developer Mode in Discord
# (User Settings > Advanced > Developer Mode), then right-click
# the avatar/server icon to copy IDs.

# === Provider ===
# Set one or both keys. OPENCLAW_MODEL controls which provider is used.
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Comma-separated chat-model list. First entry is primary; the rest
# are fallbacks tried in order when the primary 4xx/5xx/times out.
# Format: "<provider>/<model>" for each entry.
# Anthropic examples: anthropic/claude-sonnet-4-6, anthropic/claude-opus-4-7
# OpenAI examples:    openai/gpt-5.5, openai/gpt-5.4-mini
# Local examples:     ollama/qwen2.5:7b, ollama/llama3.1:8b
OPENCLAW_MODELS=anthropic/claude-sonnet-4-6,openai/gpt-5.5

# === Discord bot ===
# Discord Developer Portal > Applications > <your app> > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Comma-separated numeric user IDs of bot admins. Only these senders
# can DM the bot or invoke owner-only commands/tools.
DISCORD_ADMINS=

# Numeric ID of the Discord server the bot will operate in.
# Right-click your server icon > Copy Server ID.
DISCORD_GUILD_ID=

# === Telegram bot ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# === State paths (consumed by openclaw/docker-compose.yml) ===
# Absolute path to the state directory (bot config, session data, etc.).
# Local dev example:  OPENCLAW_CONFIG_DIR=/path/to/project/state
# VPS example:        OPENCLAW_CONFIG_DIR=/opt/openclaw/state
OPENCLAW_CONFIG_DIR=
OPENCLAW_WORKSPACE_DIR=

# === Gateway ===
# Optional remote Docker host. Set to an SSH host alias to run via SSH + Docker Compose.
# Leave empty to run OpenClaw locally without Docker.
OC_DOCKER_HOST=
# Bind gateway to loopback so it is never exposed directly to the public internet.
# Reach via `ssh -L 18789:127.0.0.1:18789 vps` or Tailscale.
# Defaults to 18789 when unset.
PORT=
OPENCLAW_BRIDGE_PORT=127.0.0.1:18790
# Stable auth token for the web UI; set once and survives restarts.
GATEWAY_TOKEN=

# === Observability (Prometheus + Grafana) ===
# Optional comma-separated hostnames/IPs allowed to serve the OpenClaw control UI.
# localhost and 127.0.0.1 are always allowed.
ALLOWED_HOSTS=
# Host/IP used for Grafana root URL and LAN bind.
GRAFANA_HOST=
# Initial Grafana admin password. Change after first login from the UI.
GRAFANA_ADMIN_PASSWORD=

# === Misc ===
OPENCLAW_TZ=America/Los_Angeles
